# Private refresh task only. Never use a VITE_ prefix for credentials.
FINNHUB_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_API_TOKEN=
# Public gateway endpoint. Required for production; empty uses a LOCAL snapshot in dev.
VITE_RATES_API_URL=
# Public HTTPS origin, e.g. https://your-domain.com (no path).
# Netlify automatically supplies URL when SITE_URL is omitted.
SITE_URL=https://ezevillo.com
# Public application path. Use / to deploy at the root of a domain.
APP_BASE_PATH=/ibit-to-btc/
