{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ibit-rates-gateway",
  "main": "worker.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_BASE_PATH": "/ibit-to-btc/",
    "ALLOWED_ORIGIN": "https://ezevillo.com"
  },
  "kv_namespaces": [
    { "binding": "RATES_KV", "id": "9f3a4355968f46f8bc2a49962c11a498" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RATES_COORDINATOR", "class_name": "RatesCoordinator" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RatesCoordinator"] }
  ],
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "781013", "simple": { "limit": 60, "period": 60 } }
  ]
}
